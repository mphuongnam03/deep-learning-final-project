POSTGRES_DB=tb_ai_db
POSTGRES_USER=tb_user
POSTGRES_PASSWORD=tb_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://tb_user:tb_password@localhost:5432/tb_ai_db
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=*

